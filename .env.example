# Copie este arquivo para ".env.local" e preencha para usar o Supabase como
# banco de dados (modo principal). Se deixar em branco / não criar o .env.local,
# a aplicação funciona normalmente usando o localStorage do navegador (modo
# fallback) — nenhuma das duas variáveis é obrigatória para rodar o projeto.
#
# NUNCA faça commit do arquivo .env.local (ele já está no .gitignore).
# A "anon key" do Supabase é uma chave pública de leitura/escrita restrita por
# Row Level Security — ainda assim, não é uma boa prática versioná-la.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
